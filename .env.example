# Copy this file to .env; fill the provider endpoint, API key and model paths.
# Runtime limits and context budgets.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
QWEN_SOCKS5_PROXY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
KIMI_API_KEY=
KIMI_BASE_URL=
SEVIR_DEMO_HOST=127.0.0.1
SEVIR_DEMO_PORT=8000
MODEL_FIXED_PROVIDER=qwen
MODEL_FIXED_NAME=qwen-plus
MODEL_ENABLE_THINKING=0
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=8192
MODEL_THINKING_BUDGET=512
MODEL_API_TIMEOUT_SECONDS=300
SEVIR_AGENT_REQUEST_TIMEOUT_SECONDS=300
SEVIR_LIVE_AGENT_REQUEST_TIMEOUT_SECONDS=86400
SEVIR_AGENT_EXECUTION_TIMEOUT_SECONDS=300
SEVIR_UNIFIED_MAX_STEPS=16
SEVIR_UNIFIED_MAX_EXECUTIONS=8
SEVIR_UNIFIED_MAX_ERROR_RETRIES=5
SEVIR_MODEL_CONCURRENCY=1
MODEL_CONTEXT_WINDOW_TOKENS=65536
SEVIR_CONTEXT_INPUT_TOKENS=24000
SEVIR_CONTEXT_TARGET_TOKENS=16000
SEVIR_CONTEXT_MARGIN_TOKENS=2048
SEVIR_CONTEXT_SUMMARY_TOKENS=1500
SEVIR_CONTEXT_RECENT_TURNS=3
SEVIR_CONTEXT_RESULT_TOKENS=2000
SEVIR_RAG_MIN_RERANK=0.05

# Local RAG worker settings. Set paths for your environment.
SEVIR_RAG_PYTHON=
SEVIR_RAG_WSL_DISTRO=Ubuntu-24.04
SEVIR_RAG_DEVICE=cuda
SEVIR_RAG_INFERENCE_MODEL_DIR=

# Optional model paths. Without overrides, CasCast is expected next to this project.
# CASCAST_ROOT=absolute-path-to-CasCast
# CASCAST_PYTHON=absolute-path-to-model-python
# AURORA_PYTHON=absolute-path-to-model-python
