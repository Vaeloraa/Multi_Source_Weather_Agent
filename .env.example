# Copy this file to .env; fill the provider endpoint, API key and model paths.
# Runtime limits and context budgets.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
QWEN_SOCKS5_PROXY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
KIMI_API_KEY=
KIMI_BASE_URL=
WEATHER_AGENT_HOST=127.0.0.1
WEATHER_AGENT_PORT=8000
MODEL_FIXED_PROVIDER=qwen
MODEL_FIXED_NAME=qwen-plus
MODEL_ENABLE_THINKING=0
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=8192
MODEL_THINKING_BUDGET=512
MODEL_API_TIMEOUT_SECONDS=300
WEATHER_AGENT_REQUEST_TIMEOUT_SECONDS=300
WEATHER_AGENT_LIVE_REQUEST_TIMEOUT_SECONDS=86400
WEATHER_AGENT_EXECUTION_TIMEOUT_SECONDS=300
WEATHER_AGENT_MAX_STEPS=16
WEATHER_AGENT_MAX_EXECUTIONS=8
WEATHER_AGENT_MAX_ERROR_RETRIES=5
WEATHER_AGENT_MODEL_CONCURRENCY=1
MODEL_CONTEXT_WINDOW_TOKENS=65536
WEATHER_AGENT_CONTEXT_INPUT_TOKENS=24000
WEATHER_AGENT_CONTEXT_TARGET_TOKENS=16000
WEATHER_AGENT_CONTEXT_MARGIN_TOKENS=2048
WEATHER_AGENT_CONTEXT_SUMMARY_TOKENS=1500
WEATHER_AGENT_CONTEXT_RECENT_TURNS=3
WEATHER_AGENT_CONTEXT_RESULT_TOKENS=2000
WEATHER_AGENT_RAG_MIN_RERANK=0.05

# Local RAG worker settings. Set paths for your environment.
WEATHER_AGENT_RAG_PYTHON=
WEATHER_AGENT_RAG_WSL_DISTRO=Ubuntu-24.04
WEATHER_AGENT_RAG_DEVICE=cuda
WEATHER_AGENT_RAG_INFERENCE_MODEL_DIR=

# Optional model paths. Without overrides, CasCast is expected next to this project.
# CASCAST_ROOT=absolute-path-to-CasCast
# CASCAST_PYTHON=absolute-path-to-model-python
# AURORA_PYTHON=absolute-path-to-model-python
