      "termination_reason": "agent_completed",
      "answer": "<execute>\n# 分析数据内容，了解天气图显示的是什么\ncube = sevir.observations()\nvalues = cube.values\n\n# 检查数据的基本统计信息\n# 注意：值255表示缺失数据\nvalid_mask = values != 255\nvalid_values = values[valid_mask]\n\n# 计算基本统计\nstats = {\n    \"min_value\": float(np.min(valid_values)),\n    \"max_value\": float(np.max(valid_values)),\n    \"mean_value\": float(np.mean(valid_values)),\n    \"std_value\": float(np.std(valid_values)),\n    \"percentile_25\": float(np.percentile(valid_values, 25)),\n    \"percentile_50\": float(np.percentile(valid_values, 50)),\n    \"percentile_75\": float(np.percentile(valid_values, 75)),\n    \"valid_pixel_count\": int(np.sum(valid_mask)),\n    \"total_pixel_count\": int(values.size),\n    \"missing_percentage\": float(np.sum(values == 255) / values.size * 100)\n}\n\n# 查看时间维度上的变化\ntime_means = []\nfor t in range(values.shape[0]):\n    frame = values[t]\n    valid_frame = frame[frame != 255]\n    if len(valid_frame) > 0:\n        time_means.append(float(np.mean(valid_frame)))\n\n# 创建可视化图表\nartifact_dir = os.environ.get('SEVIR_ARTIFACT_DIR', '/tmp')\n\n# 1. 显示某一时刻的天气图\nfig1, axes1 = plt.subplots(1, -1, figsize=(15, 5))\ntime_idx = 24  # 中间时刻\nframe_data = values[time_idx].copy()\nframe_data[frame_data == 255] = np.nan  # 将缺失值设为nan以便可视化\n\nim1 = axes1.imshow(frame_data, cmap='viridis', aspect='auto')\naxes1.set_title(f'天气图 - 时间: {cube.minutes[time_idx]}分钟 (相对开始时间)')\naxes1.set_xlabel('列')\naxes1.set_ylabel('行')\nplt.colorbar(im1, ax=axes1, label='强度值')\n\nfig1_path = os.path.join(artifact_dir, 'weather_frame.png')\nplt.savefig(fig1_path, dpi=150, bbox_inches='tight')\nplt.close(fig1)\n\n# 2. 显示时间序列变化\nfig2, axes2 = plt.subplots(1, 2, figsize=(12, -1))\n\n# 时间序列图\naxes2[0].plot(cube.minutes, time_means, marker='o')\naxes2[0].set_xlabel('时间 (分钟)')\naxes2[0].set_ylabel('平均强度')\naxes2[0].set_title('平均强度随时间变化')\naxes2[0].grid(True, alpha=0.3)\n\n# 强度分布直方图\naxes2[1].hist(valid_values.flatten(), bins=50, edgecolor='black')\naxes2[1].set_xlabel('强度值')\naxes2[1].set_ylabel('频数')\naxes2[1].set_title('强度值分布')\naxes2[1].grid(True, alpha=0.3)\n\nfig2_path = os.path.join(artifact_dir, 'time_series_distribution.png')\nplt.savefig(fig2_path, dpi=150, bbox_inches='tight')\nplt.close(fig2)\n\nresult = {\n    \"data_statistics\": stats,\n    \"time_range_minutes\": cube",
